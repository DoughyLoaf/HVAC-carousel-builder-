# Copy to .env.local for local work; set the same names on the host for production.
# Nothing in this file is a secret — the real values never go into git.

# ── Leads database ──────────────────────────────────────────────────────────
# Any Postgres. For Supabase use the "Transaction pooler" connection string.
# Leave unset on a laptop: an embedded database in ./data/ is used instead.
# In production the app refuses to accept leads without it.
DATABASE_URL=
# Optional: the database's CA certificate (PEM), to verify its TLS certificate.
DATABASE_CA_CERT=

# ── Admin (/admin) ──────────────────────────────────────────────────────────
# One shared password (10+ characters) and a random signing secret (32+).
# Generate the secret with:  openssl rand -base64 48
ADMIN_PASSWORD=
SESSION_SECRET=

# ── New-lead alerts ─────────────────────────────────────────────────────────
# Email, sent through Resend (resend.com). All three are needed.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL_TO=
LEAD_NOTIFY_EMAIL_FROM=
# And/or a webhook: a Slack incoming webhook works as-is; Zapier or Make can
# turn it into a text message.
LEAD_NOTIFY_WEBHOOK_URL=

# ── Site ────────────────────────────────────────────────────────────────────
# Public address, no trailing slash. Used in alert emails and tracked links.
SITE_URL=
# "live" turns off the preview ribbon and lets search engines in — but only
# once every launch blocker in content/site.ts is verified. Until then the
# site stays in preview whatever this says.
SITE_MODE=preview
